# ── Turso database ────────────────────────────────────────────────────────────
# Cloud URL from https://app.turso.tech or `turso db show <name>`
# Local SQLite (no auth token needed): file:./local.db
TURSO_DATABASE_URL=

# Auth token for Turso cloud databases (not needed for file: URLs)
TURSO_AUTH_TOKEN=

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=

# Your app's public URL (no trailing slash)
# Local:  http://localhost:3000
# Vercel: https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# ── Stripe (optional — omit to skip payment and place orders directly) ────────
# Test secret key from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...

# Webhook signing secret — from Stripe dashboard after creating the endpoint
# Endpoint URL: https://your-app.vercel.app/api/webhooks/stripe
# Event to listen for: checkout.session.completed
STRIPE_WEBHOOK_SECRET=whsec_...

# ── Vercel Blob (image uploads for menu items) ───────────────────────────────
# From Vercel dashboard → Storage → Blob → Create store → .env.local tab
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# ── Admin account seed ────────────────────────────────────────────────────────
# Used by: npx tsx src/db/seed-admin.ts
# Creates (or promotes) this user to the "admin" role in the database
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-min-8-chars
